[Unit]
Description=Northgate content panel and Telegram publisher
After=network-online.target

[Service]
WorkingDirectory=/opt/northgate/repo/bot
EnvironmentFile=/opt/northgate/.env
ExecStart=/usr/bin/python3 /opt/northgate/repo/bot/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
